# The server reads plain environment variables; it does not load this file by itself.
# Either export these in your shell / secret manager, or copy this file to .env (git-ignored) and
# let Node load it:   node --env-file=.env dist/index.js
# NEVER commit real keys and never paste them into a chat.

# eToro: Settings > Trading > API Key Management > Create New Key
ETORO_API_KEY=
ETORO_USER_KEY=
# Safer alternatives (set exactly ONE source per key; see README "Securing your setup"):
#   ETORO_API_KEY_CMD=security find-generic-password -s etoro-mcp-server -a api-key -w
#   ETORO_USER_KEY_FILE=~/.config/etoro-mcp/user-key     (chmod 600)

# demo (default) or real. The key pair must have been created for the same environment.
ETORO_ENV=demo
# Same choice as a switch (used by the MCPB bundle's form). Leave unset, or make it agree with ETORO_ENV.
# ETORO_USE_REAL=false

# --- Write tools: everything below is off by default -------------------------
# Register order/close/cancel/watchlist tools (needs a key with Write permission)
ETORO_ENABLE_WRITE=false
# Second switch required when ETORO_ENV=real
ETORO_ALLOW_REAL_WRITE=false
# Register the internal transfer tool (real only; needs both switches above)
ETORO_ALLOW_TRANSFERS=false
# Open the approval page in your browser when Claude prepares an action (default: true)
# ETORO_OPEN_BROWSER=true
# Put the approval page's address in the tool result (default: false). That lets Claude see it: use only for scripts
# or machines without a browser.
# ETORO_SHOW_APPROVAL_URL=false

# Refuse trading previews if the key can also write in the other environment.
# Default: true when ETORO_ENV=real, false when ETORO_ENV=demo. Set it to override.
# ETORO_STRICT_KEY_SCOPE=true

# --- Limits ------------------------------------------------------------------
ETORO_MAX_ORDER_USD=100
ETORO_MAX_SESSION_USD=500
ETORO_MAX_WRITES_PER_MINUTE=5
ETORO_CONFIRM_TTL_SECONDS=300

# Output size cap per tool result (arrays are shortened above it)
# ETORO_MAX_RESPONSE_CHARS=120000

# Log each HTTP call (method, path, status, duration) to stderr; never keys or bodies
# ETORO_DEBUG=true

# Append JSON-lines audit events to a file (also written to stderr)
# ETORO_AUDIT_LOG=~/.etoro-mcp/audit.log
